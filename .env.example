# Optional. When unset, Better Auth + app data use in-memory PGLite (preview / local).
# On Vercel, set this to a pooled Postgres URL (Neon works).
DATABASE_URL=

# better-auth. Required when NEXT_PUBLIC_AUTH_ENABLED is not "false".
BETTER_AUTH_SECRET=
# Public origin of this deployment, e.g. https://waifustudio.vercel.app
BETTER_AUTH_URL=

# "false" keeps the shared local/dev user (default for the shipped template).
# Set to "true" on Vercel when GROK_AUTH_* (or another OAuth client) is configured.
NEXT_PUBLIC_AUTH_ENABLED=false

# Grok auth broker (optional). Injected in Grok sandbox deploys; leave empty on Vercel
# unless you federate through that broker.
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=

# OpenRouter keys are NOT server env vars. Users paste a key in Settings;
# it stays in localStorage and is sent to /api/studio/* which proxies OpenRouter.

# Optional Grok preview / connector gate (sandbox only).
GROK_PROJECT_ID=
GROK_CONNECTORS_URL=
GROK_CONNECTOR_ACCESS_TOKEN=
